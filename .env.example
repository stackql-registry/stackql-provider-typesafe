# Live smoke-test credentials (copy to .env - gitignored - and fill in).
# `make smoke*` sources .env when present. Never point this at a production
# account.
#
# TypeSafe has no Terraform provider, so the names follow the vendor's SDKs
# and CLI examples (TYPESAFE_API_KEY is the variable `typesafe-sdk`,
# `@typesafe-ai/sdk` and every docs.typesafe.ai curl example read).

# The API key the provider authenticates with (Authorization: Bearer). Create
# one at https://console.typesafe.ai/keys (early access is behind a waitlist
# at https://typesafe.ai). The same key reads the models catalog and runs
# System One evaluations; there is no separate admin key class.
TYPESAFE_API_KEY=...

# No scoping variable: the API is a fixed host (https://api.typesafe.ai)
# with no organization, project or workspace path parameter.
