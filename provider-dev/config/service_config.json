{
  "retry": {
    "algorithm": "exponential",
    "max_attempts": 3,
    "initial_delay_ms": 500,
    "max_delay_ms": 10000,
    "multiplier": 2.0,
    "jitter_fraction": 0.1,
    "retryable_methods": ["GET", "HEAD", "POST"],
    "retryable_conditions": {
      "status_codes": [408, 429, 502, 503, 504, 529]
    }
  }
}
